# Batman Boilerplate — Environment Variables
# Copied to .env on first pnpm install. Use the setup wizard (pnpm dev → localhost:3001) or fill in below.

# Auth (required) — placeholder allows app to start; replace via setup wizard or: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-placeholder-replace-with-openssl-rand-32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Database (required) — placeholder allows app to start; replace with Supabase URLs via setup wizard
# Supabase: Transaction URL (port 6543, ?pgbouncer=true) and Direct URL (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batman_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/batman_dev

# Supabase Storage (optional — for file uploads, avatars)
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (optional — for password resets, verification, invites)
# RESEND_API_KEY=

# Resend "from" address. Default below works out of the box — Resend requires a verified domain,
# and onboarding@resend.dev is pre-verified for testing. For production, add your domain at
# resend.com/domains and use e.g. noreply@yourdomain.com
# RESEND_FROM_EMAIL=Batman <onboarding@resend.dev>

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Polar (optional — subscriptions, products, webhooks)
# POLAR_ACCESS_TOKEN=
# POLAR_ORGANIZATION_ID=
# POLAR_WEBHOOK_SECRET=
# POLAR_SANDBOX_MODE=false

# Set to "true" on your marketing/hosted site to show the full landing page
# NEXT_PUBLIC_MARKETING=true

# Marketing checkout (isolated from main boilerplate Polar config)
# Used only when NEXT_PUBLIC_MARKETING=true for selling the boilerplate
# POLAR_MARKETING_PRODUCT_ID=xxx
# POLAR_MARKETING_ACCESS_TOKEN=polar_at_xxx
# POLAR_MARKETING_SANDBOX=true
# If using a separate Polar org for marketing, configure its webhook to:
#   URL: https://yoursite.com/api/webhooks/polar-marketing
#   Secret: set POLAR_MARKETING_WEBHOOK_SECRET (or reuse POLAR_WEBHOOK_SECRET)
