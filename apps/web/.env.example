# Batman Boilerplate — Environment Variables
# See docs/ENV_SETUP.md for full setup guide (where to get each value, what it's for).
# Copied to .env on first pnpm install. Or use the Setup Wizard: pnpm dev → localhost:3001

# =============================================================================
# REQUIRED — Auth
# =============================================================================
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-placeholder-replace-with-openssl-rand-32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# =============================================================================
# REQUIRED — Database (PostgreSQL)
# =============================================================================
# Supabase: Transaction URL (port 6543, ?pgbouncer=true) and Direct URL (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batman_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/batman_dev

# =============================================================================
# OPTIONAL — Supabase Storage (file uploads, avatars, attachments)
# =============================================================================
# Get from Supabase Dashboard → Settings → API
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# OPTIONAL — Email (Resend: password reset, verification, invites)
# =============================================================================
# Get from resend.com → API Keys. For testing, use onboarding@resend.dev as from.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Batman <onboarding@resend.dev>

# =============================================================================
# OPTIONAL — Google OAuth (social login)
# =============================================================================
# Get from Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =============================================================================
# OPTIONAL — GitHub OAuth (social login)
# =============================================================================
# Get from GitHub → Settings → Developer settings → OAuth Apps
# Can also be configured via Admin > API Keys (stored in DB)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# OPTIONAL — Polar (payments, subscriptions)
# =============================================================================
# Get from polar.sh → Settings. Set POLAR_SANDBOX_MODE=false for production.
# POLAR_ACCESS_TOKEN=
# POLAR_ORGANIZATION_ID=
# POLAR_WEBHOOK_SECRET=
# POLAR_SANDBOX_MODE=false
