# Batman Boilerplate — Environment Variables
# Copy this file to .env and fill in your values, or use the setup wizard (pnpm dev → visit localhost:3001)

# Auth (required)
BETTER_AUTH_SECRET=         # Run: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Database (required) — Supabase PostgreSQL
DATABASE_URL=""             # Transaction URL (port 6543, append ?pgbouncer=true)
DIRECT_URL=""               # Direct/Session URL (port 5432)

# Supabase Storage (optional — for file uploads, avatars)
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (optional — for password resets, verification, invites)
# RESEND_API_KEY=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Set to "true" on your marketing/hosted site to show the full landing page
# NEXT_PUBLIC_MARKETING=true

# Purchase URL (Gumroad, Lemon Squeezy, etc.) — used by the "Get Batman" CTA
# NEXT_PUBLIC_PURCHASE_URL=https://gumroad.com/l/batman
