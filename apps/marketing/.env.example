# Copy from apps/web/.env — marketing app shares the same database and Resend.
# Add these for marketing-specific config:

# Your marketing site URL (for download links in purchase emails). Required in production.
# MARKETING_URL=https://your-marketing-site.com

# Polar marketing product (one-time codebase purchase)
# POLAR_MARKETING_PRODUCT_ID=
# POLAR_MARKETING_ACCESS_TOKEN=
# POLAR_MARKETING_WEBHOOK_SECRET=
# POLAR_MARKETING_SANDBOX=true
