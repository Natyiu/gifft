# Marketing app — minimal env

# App URL — for download links in purchase emails (use ngrok/production URL when testing)
MARKETING_URL=http://localhost:3002
# Optional: direct hosted zip URL for buyer emails (recommended in production).
# If set, purchase emails use this URL instead of /api/download/access token links.
# MARKETING_DOWNLOAD_URL=https://your-cdn-or-product-link/Batman-v6.zip

# Required by shared env package
BETTER_AUTH_SECRET=your-32-char-secret-minimum
BETTER_AUTH_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002

# Database
DATABASE_URL=
DIRECT_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Polar marketing (one-time codebase purchase)
POLAR_MARKETING_PRODUCT_ID=
POLAR_MARKETING_ACCESS_TOKEN=
POLAR_MARKETING_WEBHOOK_SECRET=
POLAR_MARKETING_SANDBOX=false
